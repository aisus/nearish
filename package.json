{
  "name": "nearish",
  "private": true,
  "version": "0.1.0",
  "description": "Interactive map of where several kinds of place are all within reach",
  "homepage": "https://aisus.github.io/nearish/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aisus/nearish.git"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --build && vite build",
    "typecheck": "vue-tsc --build",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "preview": "vite preview",
    "fetch": "tsx src/fetch/cli.ts",
    "thumbnails": "tsx src/fetch/thumbnails.ts"
  },
  "dependencies": {
    "@fontsource/fira-sans": "^5.3.0",
    "@maplibre/maplibre-gl-leaflet": "^0.1.4",
    "@turf/area": "^7.4.0",
    "@turf/bbox": "^7.4.0",
    "@turf/boolean-point-in-polygon": "^7.4.0",
    "@turf/buffer": "^7.4.0",
    "@turf/distance": "^7.4.0",
    "@turf/helpers": "^7.4.0",
    "@turf/intersect": "^7.4.0",
    "@turf/meta": "^7.4.0",
    "@turf/simplify": "^7.4.0",
    "leaflet": "^1.9.4",
    "maplibre-gl": "^6.15.0",
    "valibot": "^1.5.0",
    "vue": "^3.5.13",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tsconfig/node22": "^22.0.6",
    "@types/geojson": "^7946.0.16",
    "@types/leaflet": "^1.9.16",
    "@types/node": "^22.13.0",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.10.0",
    "globals": "^17.11.0",
    "prettier": "^3.9.6",
    "tsx": "^4.23.12",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^6.1.0",
    "vitest": "^4.1.11",
    "vue-tsc": "^2.2.0"
  },
  "engines": {
    "node": ">=22.13"
  }
}
